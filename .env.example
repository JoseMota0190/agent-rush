# Vultr Cloud API (opcional, para deploy/gestión de la VM)
VULTR_API_KEY=

# Vultr Serverless Inference (obligatoria para las runs reales)
# Products > Serverless > Inference > suscripción > Overview > API Key
VULTR_INFERENCE_API_KEY=

VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Tope de tokens por partida
MAX_TOKENS_PER_RUN=100000
MAX_TOKENS_PER_CALL=1200
